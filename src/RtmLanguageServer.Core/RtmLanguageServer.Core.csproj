<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RtmLanguageServer.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Antlr4BuildTasks" Version="12.14.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Antlr4 Include="Grammar/RtmLexer.g4" Listener="true" Visitor="false" Package="RtmLanguageServer.Core.Generated" />
    <Antlr4 Include="Grammar/RtmParser.g4">
      <Package>RtmLanguageServer.Core.Generated</Package>
      <Visitor>false</Visitor>
    </Antlr4>
  </ItemGroup>
</Project>
