<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RtmLanguageServer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Analysis\RtmIncludeDirective.cs" />
    <Compile Remove="Analysis\RtmUri.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Antlr4BuildTasks" Version="12.14.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Antlr4 Include="Grammar/RtmLexer.g4" Listener="true" Visitor="false" Package="RtmLanguageServer.Generated" />
    <Antlr4 Include="Grammar\RtmParser.g4">
      <Package>RtmLanguageServer.Generated</Package>
      <Visitor>false</Visitor>
    </Antlr4>
  </ItemGroup>
</Project>
