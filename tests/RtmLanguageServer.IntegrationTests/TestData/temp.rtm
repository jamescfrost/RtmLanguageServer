RTM

$NAME JAMES.DATA
  RANDOM.FIELD N3

$NAME JAMES.PROCS
  RANDOM.PROC PROC(NAME)
    RETURN()
  ENDPROC

$NAME JAMES.CODE
  ID_ ID+1

$NAME ....

$ENTRY JAMES.TEST

$FILES
  JAMES.DATAFILE

$EXT
  JAMES.TEST2

$DATA
  ID N5
  NAME A20
  AGE N3
$INCLUDE *(JAMES.DATA)
$INCLUDE OTHERSOURCE(OTHER.DATA)

$PROG(ID)
  ID = 12345
  NAME = "James"
  AGE = 30
  TEST(1)
  RANDOM.PROC("Test")
QUITZUG

$INCLUDE *(JAMES.PROCS)

TEST PROC(ID)
$INCLUDE *(JAMES.CODE)
  JAMES.TEST2(NAME)
  RANDOM.FIELD = 456
  OTHER.FIELD = 3210
  RETURN()
ENDPROC

$ABORT
  